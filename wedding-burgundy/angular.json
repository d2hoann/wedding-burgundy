{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "wedding-burgundy-invitation": {
      "projectType": "application", "root": "", "sourceRoot": "src", "prefix": "app",
      "architect": {
        "build": {"builder": "@angular/build:application", "options": {"browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.app.json", "styles": ["src/styles.scss"], "assets": [{"glob": "**/*", "input": "public"}]}, "configurations": {"production": {"optimization": true, "outputHashing": "all"}, "development": {"optimization": false, "sourceMap": true}}, "defaultConfiguration": "development"},
        "serve": {"builder": "@angular/build:dev-server", "configurations": {"production": {"buildTarget": "wedding-burgundy-invitation:build:production"}, "development": {"buildTarget": "wedding-burgundy-invitation:build:development"}}, "defaultConfiguration": "development"}
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
